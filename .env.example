# Skipr Server Configuration
PORT=7005
PUBLIC_URL=http://127.0.0.1:7005

# Optional: Remote MongoDB URI (if omitted, Skipr uses embedded JSON database + LRU memory)
# MONGODB_URI=mongodb://localhost:27017/skipr

# Optional: Default Debrid provider (realdebrid, torbox, alldebrid, premiumize)
DEFAULT_DEBRID_PROVIDER=realdebrid

# Optional: Upstream Scraper URL (e.g. Torrentio, Comet, or AIOStreams)
DEFAULT_SCRAPER_URL=https://torrentio.strem.fun
